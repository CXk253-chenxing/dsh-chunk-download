{
  "name": "dsh-chunk-download",
  "version": "0.3.1",
  "type": "module",
  "description": "Range 分片并发 + 断点续传的下载插件：给 AI Agent 一条比 curl 单连接快数倍的高速下载通道，跨平台",
  "author": "CXk253-chenxing",
  "license": "AGPL-3.0-or-later",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/*.md",
    "docs/*.yml",
    "assets/*.svg"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "download",
    "downloader",
    "range",
    "chunked",
    "multithread",
    "resume",
    "agent",
    "agent-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "bench": "node bench/speedup.mjs 2",
    "check": "node --check index.js && node --check lib/engine.js && node --check lib/format.js",
    "pack:plugin": "rm -rf /tmp/tarpkg && mkdir -p /tmp/tarpkg && cp -a . /tmp/tarpkg/package && rm -rf /tmp/tarpkg/package/.git && tar czf dsh-chunk-download-${npm_package_version}.tgz -C /tmp/tarpkg package",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CXk253-chenxing/dsh-chunk-download.git"
  },
  "homepage": "https://github.com/CXk253-chenxing/dsh-chunk-download#readme",
  "bugs": {
    "url": "https://github.com/CXk253-chenxing/dsh-chunk-download/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
